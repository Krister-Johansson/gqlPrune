{
  "$schema": "https://context7.com/schema/docs7.json",
  "name": "gqlPrune",
  "description": "Schema-free CLI that finds unused GraphQL operations, fragments and orphaned .gql files in TypeScript and JavaScript projects.",
  "colors": {
    "primary": "#8A5800",
    "light": "#F2B544",
    "dark": "#8A5800"
  },
