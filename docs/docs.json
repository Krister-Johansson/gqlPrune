      {
        "label": "GitHub",
        "href": "https://github.com/Krister-Johansson/gqlPrune"
      },
      { "label": "npm", "href": "https://www.npmjs.com/package/gqlprune" },
      {
        "label": "Releases",
        "href": "https://github.com/Krister-Johansson/gqlPrune/releases"
      }
    ]
  },
  "navigation": {
